# Smriti v2 — Stateless Cloud-Native Runtime Configuration
# Copy to .env for local development only. Never commit secrets.

SMRITI_ENV=dev
SMRITI_SERVICE_NAME=smriti-v2
SMRITI_VERSION=0.1.0
SMRITI_DEFAULT_DOMAIN=performance_marketing
SMRITI_REQUIRE_AUTH=false

# Google Cloud Platform (EU Region for Gemini Enterprise)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=europe-west1
BIGQUERY_DATASET=Gemini_POC
BIGQUERY_MAX_BYTES_BILLED=500000000

# Cloud Run HTTP listener port
PORT=8080
