# Smriti v2 — Stateless Cloud-Native Runtime Configuration
# Copy to .env for local development only. Never commit secrets.

SMRITI_ENV=dev
SMRITI_SERVICE_NAME=smriti-v2
SMRITI_VERSION=0.1.0
SMRITI_DEFAULT_DOMAIN=performance_marketing
SMRITI_REQUIRE_AUTH=false

# Google Cloud Platform (EU Region for Gemini Enterprise)
GCP_PROJECT_ID=gemini-poc-503210
GCP_LOCATION=europe-west1
BIGQUERY_DATASET=Gemini_POC
BIGQUERY_MAX_BYTES_BILLED=500000000

# Stateless TTL Cache (seconds)
SMRITI_CACHE_TTL_SECONDS=300

# Governed Smriti Institutional Memory & Multi-Domain Access
SMRITI_GCS_BUCKET=
SMRITI_MEMORY_APPROVERS=
SMRITI_DOMAIN_ACL=

# Live Read-Only Connectors (Mount secrets from GCP Secret Manager on Cloud Run)
MIXPANEL_PROJECT_ID=3992118
MIXPANEL_USERNAME=
MIXPANEL_SECRET=
MIXPANEL_API_HOST=https://eu.mixpanel.com

# Meta Ads Account (Strictly locked to 774668588585301 — ads_read scope only)
META_ACCESS_TOKEN=

# Google Ads Account (Kept dormant until organization turns on Google Ads)
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=

# Cloud Run HTTP listener port
PORT=8080
